<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    tools:context=".StuProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Header Banner & Avatar Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:scaleType="centerCrop"
                    android:background="#E1E3E8"
                    android:layout_marginBottom="12dp"
                    android:src="@android:drawable/ic_menu_gallery" />

                <!-- Personal Details Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStuName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Student Name: "
                        android:textColor="#1A1D1E"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SID: "
                        android:textColor="#757D8A"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingBottom="8dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Metadata Card (Gender, Grade, College, Programme, Class) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gender: "
                    android:textColor="#2C2F36"
                    android:textSize="14sp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvGradeLv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grade Level: "
                    android:textColor="#2C2F36"
                    android:textSize="14sp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvSchool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="College: "
                    android:textColor="#2C2F36"
                    android:textSize="14sp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvCourse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programme: "
                    android:textColor="#2C2F36"
                    android:textSize="14sp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Class: "
                    android:textColor="#2C2F36"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Bio Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvBio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="About Me"
                        android:textColor="#175196"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Edit"
                        android:textSize="12sp"
                        style="?android:attr/buttonStyleSmall"
                        android:backgroundTint="#175196"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvBioContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#2C2F36"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Services Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Services"
                    android:textColor="#175196"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layoutServicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- Awards Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvAward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Awards"
                    android:textColor="#175196"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layoutAwardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- Participated Activities Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvActivities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Participated Activities"
                    android:textColor="#175196"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layoutActivitiesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- Back Button -->
            <Button
                android:id="@+id/btBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back"
                android:backgroundTint="#175196"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
