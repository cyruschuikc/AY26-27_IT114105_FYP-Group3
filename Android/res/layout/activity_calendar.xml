<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA"
    android:padding="16dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#175196"
            style="?android:attr/borderlessButtonStyle"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Project Calendar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1D1E" />

        <!-- Spacer view to balance center alignment -->
        <View
            android:layout_width="48dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- Calendar Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="3dp"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Selected Date Header Banner -->
    <TextView
        android:id="@+id/tvSelectedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Events for: Select a date"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#175196"
        android:background="@android:color/white"
        android:elevation="1dp"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <!-- List of Events for the Selected Day -->
    <ListView
        android:id="@+id/lvDayEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:clipToPadding="false" />

</LinearLayout>
